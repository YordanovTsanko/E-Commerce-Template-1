# Връзка към MongoDB Atlas (СМЕНЕТЕ паролата — старата е изтекла в архива)
DB_MONGO=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority

# DEVELOPMENT локално, PRODUCTION на Render
NODE_ENV=DEVELOPMENT
PORT=5555

# Дълъг случаен низ
SESSION_SECRET=сменете-ме-с-дълъг-случаен-низ

# НОВО: адресите на фронтенда, разделени със запетая (без / накрая)
CLIENT_URL=http://localhost:3000,https://project-1-henna-tau.vercel.app
